# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://healthyapi:local_dev_password@localhost:5432/healthyapi?schema=public"

# Redis Connection (BullMQ Queue & Cache)
REDIS_URL="redis://127.0.0.1:6379"

# Authentication & Session
NEXTAUTH_SECRET="replace-with-a-random-32-char-secret"
NEXTAUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Notification settings (Optional Webhook / Email simulation)
ALERT_EMAIL_FROM="alerts@healthyapi.local"
RESEND_API_KEY=""

# Environment
NODE_ENV="development"
